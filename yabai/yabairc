#!/usr/bin/env sh

# bsp or float (default: float)
yabai -m config layout bsp

# New window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# Padding and gaps (top padding is on top of the sketchybar space reserved below)
yabai -m config top_padding 5
yabai -m config bottom_padding 5
yabai -m config left_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 10

# Reserve room for sketchybar (height=40, position=top) on every display
yabai -m config external_bar all:40:0

# set mouse interaction modifier key (default: fn)
yabai -m config mouse_modifier cmd

# set modifier + left-click drag to move window (default: move)
yabai -m config mouse_action1 move

# set modifier + right-click drag to resize window (default: resize)
yabai -m config mouse_action2 resize

# drop a window onto another to swap them (default: swap)
yabai -m config mouse_drop_action swap

# set focus follows mouse mode (default: off, options: off, autoraise, autofocus)
yabai -m config focus_follows_mouse autoraise

# Borders
borders active_color=0xffff8c00 inactive_color=0x00000000 width=6.0 hidpi=on &

# Window opacity (need SIP)
yabai -m config window_opacity on
yabai -m config window_opacity_duration 0.15
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.90

echo "yabai configuration loaded.."
